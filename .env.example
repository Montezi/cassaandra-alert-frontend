# Copy to .env.local (ignored by git) to change it.
#
# Development only: where `npm run dev` forwards /api/* requests.
# Use the local Cloud Run function (default) or a deployed Cloud Run URL.
# No VITE_ prefix on purpose: this value stays in Node and never reaches the
# browser. Never put API keys here; they live in Secret Manager (CLAUDE.md).
API_PROXY_TARGET=http://localhost:8080
